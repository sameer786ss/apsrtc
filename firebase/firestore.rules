rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC: Anyone can read blogs, circulars, union_affairs — no auth needed
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /circulars/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /union_affairs/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Users collection — each user can only read their own doc, no client writes
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Manage via Firebase Console only
    }
  }
}
